---
const sections = [
  { id: 'top', label: 'SYSTEM_00 / INICIO' },
  { id: 'proyectos', label: 'SYSTEM_01 / NODOS' },
  { id: 'sobre-mi', label: 'SYSTEM_02 / ABOUT' },
  { id: 'contacto', label: 'SYSTEM_03 / CONTACT' },
]
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-bg/0 transition-colors duration-300"
>
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5 sm:px-13">
    <a href="#top" class="font-mono text-xs tracking-[0.14em] text-accent">
      V.OLIVERO
    </a>
    <span id="nav-position" class="font-mono text-[11px] tracking-[0.1em] text-ink-dim">
      {sections[0].label}
    </span>
  </nav>
</header>

<script define:vars={{ sections }}>
  const nav = document.getElementById('site-nav')
  const posLabel = document.getElementById('nav-position')

  const onScroll = () => {
    if (!nav) return
    if (window.scrollY > 24) {
      nav.classList.add('bg-bg/85', 'backdrop-blur-md', 'border-panel-border')
    } else {
      nav.classList.remove('bg-bg/85', 'backdrop-blur-md', 'border-panel-border')
    }
  }
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  const byId = Object.fromEntries(sections.map((s) => [s.id, s.label]))
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && posLabel) {
          posLabel.textContent = byId[entry.target.id] ?? ''
        }
      })
    },
    { rootMargin: '-45% 0px -45% 0px' }
  )
  sections.forEach((s) => {
    const el = document.getElementById(s.id)
    if (el) observer.observe(el)
  })
</script>
