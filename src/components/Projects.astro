---
import { projects } from '../data/projects'
import Walker from './Walker.astro'
---

<section id="proyectos" class="mx-auto max-w-4xl px-6 py-4 sm:px-13">
  <p data-reveal class="font-mono text-[11px] tracking-[0.14em] text-accent">
    NODES // PROYECTOS
  </p>

  <div class="mt-12 flex gap-6 sm:gap-12">
  <div class="relative flex-1 pl-9 sm:pl-11">
    <!-- El camino: una sola línea que se dibuja de punta a punta con el
         scroll (scrub), no un conector por tarjeta -- ver script GSAP. -->
    <div
      id="path-line"
      class="connector-line absolute top-1 bottom-1 left-0 w-px bg-gradient-to-b from-accent via-accent to-transparent"
    >
    </div>

    {
      projects.map((project, i) => {
        const isLive = project.status !== 'Cliente'
        const nodeId = `NODE_${String(i + 1).padStart(2, '0')}`
        return (
          <div data-reveal data-slug={project.slug} class="path-stop relative pb-16 last:pb-0">
            <span
              class:list={[
                'node-dot absolute -left-9 top-1.5 h-2.5 w-2.5 -translate-x-1/2 rounded-full sm:-left-11',
                isLive ? 'bg-accent' : 'border border-ink-dim bg-bg',
              ]}
              transition:name={`node-${project.slug}`}
            />

            <p class="font-mono text-[10.5px] text-ink-dim">
              {nodeId} —{' '}
              <span class={isLive ? 'text-accent' : 'text-ink-dim'}>
                {isLive ? 'LIVE' : 'CLIENTE'}
              </span>
            </p>

            <a href={`/proyectos/${project.slug}`} class="group mt-2 inline-block">
              <span
                transition:name={`title-${project.slug}`}
                class="font-display text-2xl font-semibold text-ink-bright transition-colors group-hover:text-accent sm:text-3xl"
              >
                {project.name}
              </span>
            </a>

            <p class="mt-1.5 text-[15px] text-accent">{project.tagline}</p>

            <p class="mt-3 max-w-lg text-balance text-sm leading-relaxed text-ink-muted">
              {project.description}
            </p>

            <p class="mt-3 font-mono text-[10.5px] text-ink-dim">
              {project.tech.join('  ·  ')}
            </p>

            <a
              href={`/proyectos/${project.slug}`}
              class="mt-4 inline-block font-mono text-xs tracking-[0.08em] text-ink-muted transition-colors hover:text-accent"
            >
              VER_NODO →
            </a>
          </div>
        )
      })
    }
  </div>

  <Walker projects={projects} />
  </div>
</section>
