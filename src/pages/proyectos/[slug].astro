---
import Layout from '../../layouts/Layout.astro'
import { projects, isProjectLive, type Project } from '../../data/projects'

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

interface Props {
  project: Project
}

const { project } = Astro.props
const isLive = isProjectLive(project)
---

<Layout title={`${project.name} — Valentín Olivero`} description={project.tagline}>
  <main class="mx-auto max-w-2xl px-6 pt-40 pb-24 sm:px-13">
    <a
      href="/#proyectos"
      class="font-mono text-xs tracking-[0.08em] text-ink-dim transition-colors hover:text-accent"
    >
      ← VOLVER_AL_CAMINO
    </a>

    <div class="mt-10 flex items-center gap-4">
      <span
        transition:name={`node-${project.slug}`}
        class:list={[
          'h-2.5 w-2.5 rounded-full',
          isLive ? 'bg-accent' : 'border border-ink-dim bg-bg',
        ]}
      />
      <p class="font-mono text-[10.5px] text-ink-dim">
        <span class={isLive ? 'text-accent' : 'text-ink-dim'}>
          {isLive ? 'STATUS: LIVE' : 'STATUS: CLIENTE'}
        </span>
      </p>
    </div>

    <h1
      transition:name={`title-${project.slug}`}
      class="mt-3 font-display text-4xl font-bold text-ink-bright sm:text-5xl"
    >
      {project.name}
    </h1>

    <p class="mt-3 text-lg text-accent">{project.tagline}</p>

    <p class="mt-6 max-w-xl text-balance text-base leading-relaxed text-ink-muted">
      {project.description}
    </p>

    <div class="mt-8 flex flex-wrap gap-2">
      {
        project.tech.map((t) => (
          <span class="border border-panel-border px-2.5 py-1 font-mono text-[10.5px] text-ink-dim">
            {t}
          </span>
        ))
      }
    </div>

    <div class="mt-10 flex gap-8">
      {
        project.links.live && (
          <a
            href={project.links.live}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs tracking-[0.08em] text-ink transition-colors hover:text-accent"
          >
            ABRIR_SISTEMA →
          </a>
        )
      }
      {
        project.links.repo && (
          <a
            href={project.links.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs tracking-[0.08em] text-ink-muted transition-colors hover:text-ink"
          >
            VER_REPO →
          </a>
        )
      }
    </div>
  </main>
</Layout>
